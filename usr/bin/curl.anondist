#!/bin/bash

## Copyright (C) 2012 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

#### meta start
#### project Whonix
#### category networking
#### description
## curl tor wrapper
#### meta end

## NOTE: curl is incompatible with torsocks; it will not resolve .onion
## addresses if used with torsocks, and DNS will break completely if using IPv6
## with torsocks, thus we instead instruct curl to connect to a Tor proxy
## itself. We randomize the proxy username and password for each invocation so
## Tor will provide stream isolation.

## provides was_executed
# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/check_runtime.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/check_runtime.bsh || true
if ! declare -F was_executed >/dev/null; then
  printf '%s\n' "$0: ERROR: cannot source check_runtime.bsh!" >&2
  ## return (not exit) when sourced so a test harness is not terminated.
  return 1 2>/dev/null || exit 1
fi

## provides random_alpha_numeric
# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/strings.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/strings.bsh || true
if ! declare -F random_alpha_numeric >/dev/null; then
  printf '%s\n' "$0: ERROR: cannot source strings.bsh!" >&2
  ## return (not exit) when sourced so a test harness is not terminated.
  return 1 2>/dev/null || exit 1
fi

## Split into a function so tests can override it.
exec_uwtwrapper() {
  ## Restore the caller's LC_ALL (saved in main before forcing C) so the wrapped
  ## application runs under the caller's locale, not uwt's internal C.
  if [ -n "${uwt_caller_lc_all:-}" ]; then
    export LC_ALL="${uwt_caller_lc_all}"
  else
    unset LC_ALL
  fi
  exec /usr/libexec/uwt/uwtwrapper "$@"
}

main() {
  ## Save the caller's LC_ALL before forcing C, so exec_uwtwrapper can restore it.
  uwt_caller_lc_all="${LC_ALL:-}"

  set -o errexit
  set -o nounset
  set -o pipefail
  set -o errtrace
  shopt -s inherit_errexit
  shopt -s shift_verbose
  export LC_ALL=C

  if [ ! "${uwtwrapper_verbose:-}" = "" ]; then
    if [ "${uwtwrapper_verbose}" -ge 1 ]; then
      set -x
    fi
  fi

  true "$0: START"

  if test -o xtrace; then
    uwtwrapper_verbose=1
    export uwtwrapper_verbose
  fi

  export uwtwrapper_parent="${BASH_SOURCE[0]}"

  [[ -v UWT_DEV_PASSTHROUGH ]] || UWT_DEV_PASSTHROUGH=""

  if [ "$UWT_DEV_PASSTHROUGH" = 1 ]; then
    ## UWT_DEV_PASSTHROUGH=1 is already set. Obey it.
    ## For example, this is useful to prevent 'qubes-whonix-torified-updates-proxy-check.service'
    ## from picking up diagnostic output by this script such as the following.
    ## > WARNING: Tor proxy doesn't seem to be functional. Stream isolation will be disabled.
    exec_uwtwrapper "${@}"
  fi

  ## Prevent 'uwtwrapper' from prepending 'torsocks'.
  ## This script injects 'curl' with the '--proxy' option, so torsocks should not be used.
  export UWT_DEV_PASSTHROUGH=1

  curl_args=( "$@" )
  curl_binary="$(command -v curl.anondist-orig)" || curl_binary=""
  ## When true, curl runs WITHOUT the injected SOCKS proxy. On Whonix this is not
  ## a leak: the Gateway transparently torifies all Workstation traffic via its
  ## TransPort/DnsPort regardless. It only means the stream shares a Tor circuit
  ## (identity-correlation risk) instead of getting its own isolated one.
  ## https://www.whonix.org/wiki/Stream_Isolation
  disable_stream_isolation='false'
  found_ipv6_arg='false'

  for curl_arg in "${curl_args[@]}"; do
    ## Unfortunately curl's argument parser makes it impossible to determine
    ## what is an option, what is an argument to an option, and what is a URL,
    ## without knowing all the options it supports and parsing them accordingly.
    ## This is because rather than having short options like `-oarg` and long
    ## options like `--option=arg`, curl uses `-o arg` and `--option arg`. We
    ## can make a good guess that if a proxy-related argument is present in the
    ## command line, the user is probably managing proxying manually, but this
    ## will break if someone passes `-U` or `-x` as an argument to some other
    ## option (which could happen if the user is attempting to reference a file
    ## named `-U` or `-x`). Beyond that, the user might have their own proxy
    ## setup stored in a config file that they pass using the `-K` or `--config`
    ## argument, meaning we either have to parse curl config files too, or we
    ## have to live with an incomplete solution and tell people to call the
    ## original curl binary if things don't quite work.
    ##
    ## Using a simple but incomplete solution for now.
    if [ "${curl_arg}" = '--proxy' ] \
      || [ "${curl_arg}" = '-x' ]; then
      printf '%s\n' "WARNING: Detected '--proxy' or '-x' argument. Stream isolation will be disabled." 1>&2
      disable_stream_isolation='true'
    fi
    if [ "${curl_arg}" = '--proxy-user' ] \
      || [ "${curl_arg}" = '-U' ]; then
      printf '%s\n' "WARNING: Detected '--proxy-user' or '-U' argument. Stream isolation will be disabled." 1>&2
      disable_stream_isolation='true'
    fi
    if [ "${curl_arg}" = '--ipv6' ] \
      || [ "${curl_arg}" = '-6' ]; then
      found_ipv6_arg='true'
    fi
    if [ "${curl_arg}" = '--config' ] \
      || [ "${curl_arg}" = '-K' ]; then
      if [ -n "${curl_binary}" ]; then
        printf '%s\n' "ERROR: Detected '--config' or '-K' argument. The uwt curl wrapper cannot handle this. Please use '${curl_binary}' instead." 1>&2
      else
        printf '%s\n' "ERROR: Detected '--config' or '-K' argument. The uwt curl wrapper cannot handle this." 1>&2
      fi
      exit 1
    fi
  done

  if [ "${disable_stream_isolation}" = 'true' ]; then
    exec_uwtwrapper "${curl_args[@]}"
  fi

  curl_proxy_addr=""
  if [ "${found_ipv6_arg}" = 'true' ]; then
    printf '%s\n' "NOTICE: Detected '--ipv6' or '-6' argument, will attempt to use IPv6 Tor proxy." 1>&2
    curl_proxy_addr="[::1]:9050"
  else
    curl_proxy_addr="127.0.0.1:9050"
  fi

  if [ -n "${curl_binary}" ]; then
    ## The probe must reach the local Tor port DIRECTLY so user config cannot
    ## spuriously fail it and drop stream isolation: --disable (first arg)
    ## ignores ~/.curlrc and --noproxy '*' overrides any proxy env var
    ## (ALL_PROXY/http_proxy/...) that would otherwise route the probe through a
    ## proxy. 'timeout' hard-caps a wedged probe (stronger than curl --max-time).
    if ! timeout --kill-after=10 10 "${curl_binary}" --disable --noproxy '*' "http://${curl_proxy_addr}/" --output /dev/null 2>/dev/null; then
      printf '%s\n' "WARNING: Tor proxy doesn't seem to be functional. Stream isolation will be disabled." 1>&2
      disable_stream_isolation='true'
    fi
  fi

  if [ "${disable_stream_isolation}" = 'true' ]; then
    exec_uwtwrapper "${curl_args[@]}"
  fi

  ## https://spec.torproject.org/socks-extensions.html
  random_socks_password="$(random_alpha_numeric 43)"
  ## '--noproxy' makes curl connect DIRECTLY (bypassing the injected SOCKS proxy)
  ## for a loopback DESTINATION, classified PER-URL by curl's own URL parser --
  ## replacing hand-rolled host extraction. curl normalizes the host (so 127.1,
  ## 0x7f000001 and 0177.0.0.1 all match 127.0.0.0/8), matches case-insensitively
  ## and by domain suffix (LOCALHOST, foo.localhost, localhost.), and decides per
  ## URL (a mixed 'http://a/ http://localhost/' isolates only the remote one).
  ## '--noproxy' applies to a SOCKS proxy, not only HTTP; CIDR needs curl >= 7.86.0
  ## (trixie ships 8.x).
  ## Known scope of the '--noproxy' approach (all fail-closed, none a Tor leak):
  ##   - A CALLER's own '--noproxy' REPLACES this list (curl is last-wins and the
  ##     injected args are prepended, so the caller's is later), so a loopback
  ##     target they did not list goes to the SOCKS proxy, which Tor refuses for
  ##     loopback -> fails fast. The injected '--proxy' still applies, so isolation
  ##     is NOT lost for the other hosts (hence '--noproxy' is NOT in the
  ##     caller-manages-proxy passthrough set above, unlike '--proxy'/'-U').
  ##   - The bypass also applies to '-L' REDIRECT targets, so a remote server can
  ##     redirect curl onto a Workstation-LOCAL service (an SSRF gadget). Outside
  ##     this wrapper's scope: it torifies, it does not sandbox local services, and
  ##     loopback is non-torified BY DESIGN.
  ##   - Loopback spellings curl's '--noproxy' does NOT match -- IPv4-mapped IPv6
  ##     ('[::ffff:127.0.0.1]'), mixed hex/short ('0X7f.1') and /etc/hosts aliases
  ##     ('ip6-localhost') -- are handed to the SOCKS proxy, which Tor refuses for
  ##     loopback, so they fail fast and visibly.
  ## https://www.whonix.org/wiki/Stream_Isolation
  extra_curl_args=(
    '--proxy' "socks5h://${curl_proxy_addr}/"
    '--proxy-user' "<torS0X>0:curl-wrapper_${random_socks_password}"
    '--noproxy' 'localhost,127.0.0.0/8,::1'
  )

  ## The injected proxy applies to a SINGLE target. curl resets options at a
  ## literal '--next', so a multi-request invocation ('url1 --next url2') stream-
  ## isolates only the FIRST segment; later segments are deliberately NOT covered
  ## (no argv gymnastics to re-inject per segment). Not a leak on Whonix -- the
  ## Gateway torifies regardless; the later segments just share a Tor circuit.
  curl_args=( "${extra_curl_args[@]}" "${curl_args[@]}" )

  exec_uwtwrapper "${curl_args[@]}"
}

if was_executed "${BASH_SOURCE[0]}"; then
  main "$@"
fi
